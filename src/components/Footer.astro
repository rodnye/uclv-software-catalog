---
import Logo from './Logo.astro';
---

<footer class="mt-auto border-t border-line bg-surface">
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6">
    <div class="flex flex-col items-center gap-3 text-center">
      <Logo />
      <p class="max-w-md text-xs leading-relaxed text-ink-secondary">
        Hosting de programas de la
        <a
          href="https://www.uclv.edu.cu"
          target="_blank"
          rel="noopener noreferrer"
          class="text-primary hover:underline"
        >
          Universidad Central Marta Abreu de Las Villas
        </a>. Disponible sin consumo de tarifa de internet en Cuba.
      </p>
    </div>
  </div>
</footer>
