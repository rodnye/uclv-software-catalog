---
interface Props {
  categories: string[];
}

const { categories } = Astro.props;
---

<nav
  class="hide-scrollbar -mx-4 flex gap-2 overflow-x-auto px-4 pb-1 sm:mx-0 sm:px-0"
  aria-label="Categorías"
>
  <button
    data-category-filter="all"
    class="category-chip shrink-0 rounded-full border border-primary bg-primary-light px-4 py-1.5 text-xs font-medium text-primary transition-colors"
  >
    Todas
  </button>
  {
    categories.map((cat) => (
      <button
        data-category-filter={cat}
        class="category-chip shrink-0 rounded-full border border-line bg-surface px-4 py-1.5 text-xs font-medium text-ink-secondary transition-colors hover:border-ink-secondary/40"
      >
        {cat}
      </button>
    ))
  }
</nav>
