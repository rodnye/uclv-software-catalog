---
import type { CollectionEntry } from 'astro:content';
import AppIcon from './AppIcon.astro';
import { totalSize, getCategoryColor } from '../lib/utils';

interface Props {
  app: CollectionEntry<'apps'>;
}

const { app } = Astro.props;
const {
  name,
  shortDescription,
  category,
  iconUrl,
  iconBg,
  iconColor,
  downloads,
} = app.data;
const href = `/app/${app.id}/`;
const size = totalSize(downloads);
---

<a
  href={href}
  data-name={name.toLowerCase()}
  data-category={category}
  class="app-card group flex items-start gap-4 rounded-2xl border border-line bg-surface p-4 transition-all duration-200 hover:shadow-md hover:shadow-black/5 hover:border-line/60 hover:-translate-y-0.5"
>
  <AppIcon
    name={name}
    iconUrl={iconUrl}
    iconBg={iconBg}
    iconColor={iconColor}
    size="sm"
  />
  <div class="min-w-0 flex-1">
    <h3
      class="truncate text-sm font-medium text-ink group-hover:text-primary transition-colors"
    >
      {name}
    </h3>
    <p class="mt-0.5 line-clamp-2 text-xs leading-relaxed text-ink-secondary">
      {shortDescription}
    </p>
    <div class="mt-2 flex items-center gap-2">
      <span
        class={`inline-block rounded-full border px-2 py-0.5 text-[10px] font-medium ${getCategoryColor(category)}`}
      >
        {category}
      </span>
      <span class="text-[10px] text-ink-secondary">{size}</span>
    </div>
  </div>
  <svg
    class="mt-1 h-4 w-4 shrink-0 text-line group-hover:text-primary transition-colors"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2"
  >
    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"
    ></path>
  </svg>
</a>
